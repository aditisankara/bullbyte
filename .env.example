# BullByte Environment Configuration
# Copy this file to .env and fill in real values before running docker compose up
# NEVER commit .env — it is git-ignored.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string — db is the Docker service hostname
DATABASE_URL=postgresql://postgres:postgres@db:5432/bullbyte

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis connection string — redis is the Docker service hostname
# Used exclusively as BullMQ backing store for the async job queue
REDIS_URL=redis://redis:6379

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Active LLM provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic API key (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# ─── EDGAR ────────────────────────────────────────────────────────────────────
# SEC EDGAR requires a descriptive User-Agent identifying your application
# Format: AppName/Version contact@email.com
EDGAR_USER_AGENT=BullByte/1.0 your-email@example.com

# ─── Inter-Service URLs (Docker internal hostnames) ───────────────────────────
# IMPORTANT: Use Docker service hostnames (ml-sidecar, api) — NOT localhost
# These are internal Docker network addresses not exposed to the host machine
ML_SIDECAR_URL=http://ml-sidecar:8000
NESTJS_WEBHOOK_URL=http://api:3000/internal

# Shared secret for the FastAPI -> NestJS internal progress webhook (story 5.3).
# NestJS validates the X-Internal-Token header against this; FastAPI sends it.
# Generate a strong random value in real environments.
INTERNAL_WEBHOOK_SECRET=change-me-in-prod

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# ─── Rate Limiting (NestJS Throttler) ─────────────────────────────────────────
# THROTTLE_TTL: time window in seconds
# THROTTLE_LIMIT: max requests per IP within the window
THROTTLE_TTL=60
THROTTLE_LIMIT=10
