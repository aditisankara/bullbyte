{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"compilerOptions": {
		"deleteOutDir": true,
		"assets": [
			{ "include": "db/migrations/**/*.sql", "watchAssets": true },
			{ "include": "db/migrations/meta/*.json", "watchAssets": true }
		]
	}
}
